	<queryString language="SQL"><![CDATA[SELECT numero_orden, fecha_ingreso, cliente, placa, vehiculo, estado_descripcion AS estado,
       total, total_pagado, saldo
FROM dbo.vw_OrdenesResumen
ORDER BY fecha_ingreso DESC]]></queryString>
