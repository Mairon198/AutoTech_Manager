	<variable name="sumaPagado" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{total_pagado}]]></variableExpression></variable>
	<variable name="sumaSaldo" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{saldo}]]></variableExpression></variable>
