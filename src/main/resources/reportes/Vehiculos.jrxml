	<queryString language="SQL"><![CDATA[SELECT v.placa, v.marca, v.modelo, v.anio, v.color, v.kilometraje, v.combustible,
       c.nombre AS propietario, v.activo
FROM dbo.Vehiculos v
INNER JOIN dbo.Clientes c ON c.cliente_id = v.cliente_id
ORDER BY v.placa]]></queryString>
