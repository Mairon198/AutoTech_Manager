	<queryString language="SQL"><![CDATA[SELECT r.codigo, r.nombre, r.categoria, r.marca, p.nombre AS proveedor,
       r.stock_actual, r.stock_minimo, r.precio_venta
FROM dbo.Repuestos r
LEFT JOIN dbo.Proveedores p ON p.proveedor_id = r.proveedor_id
ORDER BY r.categoria, r.codigo]]></queryString>
	<field name="codigo" class="java.lang.String"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="categoria" class="java.lang.String"/>
	<field name="marca" class="java.lang.String"/>
